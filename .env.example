# Required only for live generation. The demo and the whole test suite run without it,
# using the deterministic FakeModel.
ANTHROPIC_API_KEY=

# Model used for answer generation. Defaults to claude-opus-5.
DATAGRAPH_MODEL=claude-opus-5

# Path to the SQLite database. Defaults to ./datagraph.db
DATAGRAPH_DB=datagraph.db
